<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_application_kanban" model="ir.ui.view">
        <field name="name">job.application.kanban</field>
        <field name="model">job.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="company_name"/>
                <field name="location"/>
                <field name="source"/>
                <field name="sponsorship_status"/>
                <field name="match_score"/>
                <field name="state"/>
                <field name="date_found"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="company_name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div t-if="record.location.raw_value">
                                    <i class="fa fa-map-marker" title="Location" aria-label="Location"/>
                                    <field name="location"/>
                                </div>
                                <div>
                                    <span>Match: </span>
                                    <field name="match_score"/>
                                    <span>%</span>
                                </div>
                                <div>
                                    <span>Sponsorship: </span>
                                    <field name="sponsorship_status"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="source"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="date_found"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_job_application_tree" model="ir.ui.view">
        <field name="name">job.application.tree</field>
        <field name="model">job.application</field>
        <field name="arch" type="xml">
            <tree string="Job Applications" default_order="date_found desc, id desc">
                <field name="name"/>
                <field name="company_name"/>
                <field name="location" optional="show"/>
                <field name="source" optional="show"/>
                <field name="sponsorship_status" optional="show"/>
                <field name="match_score" optional="show"/>
                <field name="state"/>
                <field name="date_found" optional="show"/>
                <field name="date_applied" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_job_application_form" model="ir.ui.view">
        <field name="name">job.application.form</field>
        <field name="model">job.application</field>
        <field name="arch" type="xml">
            <form string="Job Application">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Software Engineer"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_name"/>
                            <field name="location"/>
                            <field name="job_url" widget="url"/>
                            <field name="source"/>
                            <field name="sponsorship_status"/>
                        </group>
                        <group>
                            <field name="match_score"/>
                            <field name="date_found"/>
                            <field name="date_applied"/>
                            <field name="salary_min"/>
                            <field name="salary_max"/>
                            <field name="salary_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Description" name="job_description">
                            <field name="job_description" placeholder="Paste the job description here..."/>
                        </page>
                        <page string="Application Documents" name="application_documents">
                            <group>
                                <field name="cv_filename" invisible="1"/>
                                <field name="cv_file" filename="cv_filename"/>
                            </group>
                            <field name="cover_letter" placeholder="Draft the cover letter here..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add interview notes, contacts, or follow-up details..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_application_search" model="ir.ui.view">
        <field name="name">job.application.search</field>
        <field name="model">job.application</field>
        <field name="arch" type="xml">
            <search string="Search Job Applications">
                <field name="name"/>
                <field name="company_name"/>
                <field name="location"/>
                <field name="source"/>
                <separator/>
                <filter name="state_found" string="Found" domain="[('state', '=', 'found')]"/>
                <filter name="state_analysing" string="Analysing" domain="[('state', '=', 'analysing')]"/>
                <filter name="state_good_match" string="Good Match" domain="[('state', '=', 'good_match')]"/>
                <filter name="state_ready_to_apply" string="Ready to Apply" domain="[('state', '=', 'ready_to_apply')]"/>
                <filter name="state_applied" string="Applied" domain="[('state', '=', 'applied')]"/>
                <filter name="state_interview" string="Interview" domain="[('state', '=', 'interview')]"/>
                <filter name="state_offer" string="Offer" domain="[('state', '=', 'offer')]"/>
                <filter name="state_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="sponsorship_yes" string="Sponsorship: Yes" domain="[('sponsorship_status', '=', 'yes')]"/>
                <filter name="sponsorship_no" string="Sponsorship: No" domain="[('sponsorship_status', '=', 'no')]"/>
                <filter name="sponsorship_unknown" string="Sponsorship: Unknown" domain="[('sponsorship_status', '=', 'unknown')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_job_application" model="ir.actions.act_window">
        <field name="name">Job Applications</field>
        <field name="res_model">job.application</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_job_application_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first job application</p>
            <p>Track each opportunity from discovery through the final decision.</p>
        </field>
    </record>

    <menuitem id="menu_job_hunter_root"
              name="Job Hunter"
              sequence="10"
              groups="job_hunter_management.group_job_hunter_user"/>

    <menuitem id="menu_job_application"
              name="Job Applications"
              parent="menu_job_hunter_root"
              action="action_job_application"
              sequence="10"
              groups="job_hunter_management.group_job_hunter_user"/>
</odoo>
