<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_sponsorship_rule_tree" model="ir.ui.view">
        <field name="name">job.sponsorship.rule.tree</field>
        <field name="model">job.sponsorship.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="yes_adjustment"/>
                <field name="unknown_adjustment"/>
                <field name="no_adjustment"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_job_sponsorship_rule_form" model="ir.ui.view">
        <field name="name">job.sponsorship.rule.form</field>
        <field name="model">job.sponsorship.rule</field>
        <field name="arch" type="xml">
            <form string="Sponsorship Priority Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Priority score adjustments">
                        <field name="yes_adjustment"/>
                        <field name="unknown_adjustment"/>
                        <field name="no_adjustment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_job_sponsorship_rule" model="ir.actions.act_window">
        <field name="name">Sponsorship Priority Rules</field>
        <field name="res_model">job.sponsorship.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_job_sponsorship_rule" name="Sponsorship Priority Rules"
              parent="menu_job_hunter_root" action="action_job_sponsorship_rule"
              sequence="50" groups="job_hunter_management.group_job_hunter_user"/>
</odoo>
