<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_hunter_profile_tree" model="ir.ui.view">
        <field name="name">job.hunter.profile.tree</field>
        <field name="model">job.hunter.profile</field>
        <field name="arch" type="xml">
            <tree>
                <header><button name="action_run_all_hermes_searches" type="object" string="Run All Hermes Searches" class="oe_highlight"/></header>
                <field name="name"/><field name="version"/><field name="years_experience"/><field name="location"/><field name="last_hermes_search_at"/><field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_job_hunter_profile_form" model="ir.ui.view">
        <field name="name">job.hunter.profile.form</field>
        <field name="model">job.hunter.profile</field>
        <field name="arch" type="xml">
            <form string="Professional Profile">
                <header><button name="action_run_hermes_search" type="object" string="Run Hermes Search" class="oe_highlight"/></header>
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="active"/><field name="version"/><field name="years_experience"/><field name="location"/></group>
                        <group><field name="target_salary"/><field name="salary_currency"/><field name="remote_ok"/><field name="hybrid_ok"/><field name="onsite_ok"/><field name="last_hermes_search_at"/></group>
                    </group>
                    <notebook>
                        <page string="Capabilities"><group><field name="skills" placeholder="Python, Odoo, PostgreSQL"/><field name="technologies" placeholder="Docker, Git, Linux"/><field name="target_roles" placeholder="Odoo Developer, Python Developer"/><field name="languages" placeholder="English: fluent"/></group></page>
                        <page string="Background"><field name="work_experience"/><field name="education"/><field name="certifications"/></page>
                        <page string="Primary CV"><group><field name="primary_cv_filename" invisible="1"/><field name="primary_cv" filename="primary_cv_filename"/><field name="cv_checksum"/></group><p class="text-muted">Vacancy analyses reference this CV by profile version and checksum; the file is not copied to each vacancy.</p></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_job_hunter_match_rule_tree" model="ir.ui.view">
        <field name="name">job.hunter.match.rule.tree</field><field name="model">job.hunter.match.rule</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="medium_score"/><field name="high_score"/><field name="medium_state"/><field name="low_state"/><field name="active"/></tree></field>
    </record>
    <record id="view_job_hunter_match_rule_form" model="ir.ui.view">
        <field name="name">job.hunter.match.rule.form</field><field name="model">job.hunter.match.rule</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="active"/><field name="medium_score"/><field name="high_score"/><field name="medium_state"/><field name="low_state"/></group></sheet></form></field>
    </record>
    <record id="action_job_hunter_profile" model="ir.actions.act_window"><field name="name">Professional Profiles</field><field name="res_model">job.hunter.profile</field><field name="view_mode">tree,form</field></record>
    <record id="action_job_hunter_match_rule" model="ir.actions.act_window"><field name="name">Matching Rules</field><field name="res_model">job.hunter.match.rule</field><field name="view_mode">tree,form</field></record>
    <menuitem id="menu_job_hunter_profile" name="Professional Profiles" parent="menu_job_hunter_root" action="action_job_hunter_profile" sequence="40" groups="job_hunter_management.group_job_hunter_user"/>
    <menuitem id="menu_job_hunter_match_rule" name="Matching Rules" parent="menu_job_hunter_root" action="action_job_hunter_match_rule" sequence="50" groups="job_hunter_management.group_job_hunter_user"/>
</odoo>
