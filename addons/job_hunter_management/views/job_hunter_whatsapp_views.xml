<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_application_form_whatsapp" model="ir.ui.view">
        <field name="name">job.application.form.whatsapp</field>
        <field name="model">job.application</field>
        <field name="inherit_id" ref="job_hunter_management.view_job_application_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_generate_documents']" position="after">
                <button name="action_queue_whatsapp_notification" type="object"
                        string="Queue WhatsApp Notification"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp" name="whatsapp">
                    <p class="text-muted">Only prioritized opportunities are queued. Delivery is performed by an authenticated external adapter; queuing never applies to a vacancy.</p>
                    <group>
                        <field name="whatsapp_ignored_at" readonly="1"/>
                        <field name="whatsapp_ignored_reason" readonly="1"/>
                    </group>
                    <separator string="Notification outbox"/>
                    <field name="whatsapp_notification_ids" readonly="1">
                        <tree create="0" delete="0">
                            <field name="create_date"/><field name="kind"/><field name="short_ref"/>
                            <field name="job_ref"/><field name="priority_snapshot"/><field name="delivery_state"/><field name="delivered_at"/>
                        </tree>
                    </field>
                    <separator string="Explicit approvals"/>
                    <field name="whatsapp_approval_ids" readonly="1">
                        <tree create="0" delete="0">
                            <field name="approved_at"/><field name="approved_by_number"/><field name="is_current"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_job_whatsapp_settings" model="ir.ui.view">
        <field name="name">res.config.settings.job.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' settings ')]" position="inside">
                <div class="app_settings_block" data-string="Job Hunter" string="Job Hunter" data-key="job_hunter_management" groups="base.group_system">
                    <h2>Job opportunity notifications</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="job_whatsapp_enabled"/></div>
                            <div class="o_setting_right_pane">
                                <label for="job_whatsapp_enabled"/>
                                <div class="text-muted">Disabled by default. Enable only after configuring the authorized recipient and an authenticated n8n/WuzAPI adapter.</div>
                                <div class="content-group mt16">
                                    <label for="job_whatsapp_authorized_number"/>
                                    <field name="job_whatsapp_authorized_number" placeholder="+61400123456"/>
                                    <label for="job_whatsapp_minimum_priority"/>
                                    <field name="job_whatsapp_minimum_priority"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <h2>Real job sources</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"><field name="job_adzuna_enabled"/></div>
                            <div class="o_setting_right_pane">
                                <label for="job_adzuna_enabled"/>
                                <div class="text-muted">Uses the official Adzuna Australia API only. Credentials are stored as protected system parameters.</div>
                                <div class="content-group mt16">
                                    <label for="job_adzuna_app_id"/>
                                    <field name="job_adzuna_app_id" password="True" autocomplete="off"/>
                                    <label for="job_adzuna_app_key"/>
                                    <field name="job_adzuna_app_key" password="True" autocomplete="off"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_job_hunter_settings" model="ir.actions.act_window">
        <field name="name">WhatsApp Notifications</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'job_hunter_management'}</field>
    </record>
    <menuitem id="menu_job_hunter_settings" name="WhatsApp Settings"
              parent="job_hunter_management.menu_job_hunter_root"
              action="action_job_hunter_settings" sequence="90" groups="base.group_system"/>
</odoo>
