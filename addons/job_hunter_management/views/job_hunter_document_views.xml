<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_application_document_tree" model="ir.ui.view">
        <field name="name">job.application.document.tree</field>
        <field name="model">job.application.document</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="application_id"/><field name="version"/><field name="state"/>
                <field name="profile_id"/><field name="profile_version"/><field name="generated_at"/>
                <field name="validation_state"/>
            </tree>
        </field>
    </record>
    <record id="view_job_application_document_form" model="ir.ui.view">
        <field name="name">job.application.document.form</field>
        <field name="model">job.application.document</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_review" type="object" string="Mark Reviewed" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'reviewed')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,approved"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="application_id" readonly="1"/><field name="profile_id" readonly="1"/><field name="profile_version"/><field name="version"/></group>
                        <group><field name="generated_at"/><field name="generated_by"/><field name="reviewed_at"/><field name="approved_at"/></group>
                    </group>
                    <group string="Traceability">
                        <group><field name="generator_origin"/><field name="generator_model"/><field name="prompt_version"/></group>
                        <group><field name="master_cv_filename"/><field name="master_cv_checksum"/><field name="validation_state"/><field name="validation_message"/></group>
                    </group>
                    <notebook>
                        <page string="Tailored CV"><field name="tailored_cv" attrs="{'readonly': [('state', '!=', 'draft')]}"/></page>
                        <page string="Cover Letter"><field name="cover_letter" attrs="{'readonly': [('state', '!=', 'draft')]}"/></page>
                        <page string="Change Summary"><field name="change_summary"/><field name="generation_metadata" widget="json"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_job_application_document" model="ir.actions.act_window">
        <field name="name">Tailored Documents</field><field name="res_model">job.application.document</field>
        <field name="view_mode">tree,form</field><field name="context">{'create': False}</field>
    </record>
    <record id="view_job_document_generation_rule_tree" model="ir.ui.view">
        <field name="name">job.document.generation.rule.tree</field><field name="model">job.document.generation.rule</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="minimum_priority_score"/><field name="active"/></tree></field>
    </record>
    <record id="view_job_document_generation_rule_form" model="ir.ui.view">
        <field name="name">job.document.generation.rule.form</field><field name="model">job.document.generation.rule</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="minimum_priority_score"/><field name="active"/></group></sheet></form></field>
    </record>
    <record id="action_job_document_generation_rule" model="ir.actions.act_window">
        <field name="name">Document Generation Rules</field><field name="res_model">job.document.generation.rule</field><field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_job_application_document" name="Tailored Documents" parent="menu_job_hunter_root"
              action="action_job_application_document" sequence="20" groups="job_hunter_management.group_job_hunter_user"/>
    <menuitem id="menu_job_document_generation_rule" name="Document Generation Rules" parent="menu_job_hunter_root"
              action="action_job_document_generation_rule" sequence="60" groups="job_hunter_management.group_job_hunter_user"/>
</odoo>
