<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_job_hunter_management" model="ir.module.category">
        <field name="name">Job Hunter</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_job_hunter_user" model="res.groups">
        <field name="name">Job Hunter User</field>
        <field name="category_id" ref="module_category_job_hunter_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_job_hunter_e2e_cleanup" model="res.groups">
        <field name="name">Job Hunter E2E Cleanup</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('job_hunter_management.group_job_hunter_user'))]"/>
    </record>
</odoo>
