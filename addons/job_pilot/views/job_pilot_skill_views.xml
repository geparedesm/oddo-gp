<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_pilot_skill_category_list" model="ir.ui.view">
        <field name="name">job_pilot.skill.category.list</field>
        <field name="model">job_pilot.skill.category</field>
        <field name="arch" type="xml">
            <tree string="Skill Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_job_pilot_skill_category" model="ir.actions.act_window">
        <field name="name">Skill Categories</field>
        <field name="res_model">job_pilot.skill.category</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
