<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_job_pilot_cv_upload_list" model="ir.ui.view">
        <field name="name">job_pilot.cv.upload.list</field>
        <field name="model">job_pilot.cv.upload</field>
        <field name="arch" type="xml">
            <tree string="CV Uploads">
                <field name="filename"/>
                <field name="profile_id"/>
                <field name="state"/>
                <field name="pending_review_count"/>
                <field name="unclassified_count"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_job_pilot_cv_upload_form" model="ir.ui.view">
        <field name="name">job_pilot.cv.upload.form</field>
        <field name="model">job_pilot.cv.upload</field>
        <field name="arch" type="xml">
            <form string="CV Upload">
                <header>
                    <button name="action_extract_text" type="object" string="Extract Text"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_extract_with_codex" type="object" string="Extract with Codex"
                            class="oe_highlight" attrs="{'invisible': [('state', '=', 'imported')]}"/>

                    <button name="action_parse" type="object" string="Parse"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'extracted')]}"/>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'parsed')]}"/>
                    <button name="action_import" type="object" string="Import"
                            class="oe_highlight" attrs="{'invisible': [('state', '!=', 'reviewed')]}"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,extracted,parsed,reviewed,imported"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="review_line_count"/>
                            <field name="pending_review_count"/>
                            <field name="unclassified_count"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message"/>
                    </div>
                    <notebook>
                        <page string="Extracted Text">
                            <field name="extracted_text" readonly="1"/>
                        </page>
                        <page string="Proposed Changes (Review &amp; Duplicate Decisions)">
                            <field name="review_line_ids">
                                <tree editable="bottom" decoration-warning="decision == 'pending'">
                                    <field name="section"/>
                                    <field name="field_label"/>
                                    <field name="current_value"/>
                                    <field name="new_value"/>
                                    <field name="is_duplicate"/>
                                    <field name="decision"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Unclassified Information">
                            <field name="unclassified_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="content"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_job_pilot_cv_upload_search" model="ir.ui.view">
        <field name="name">job_pilot.cv.upload.search</field>
        <field name="model">job_pilot.cv.upload</field>
        <field name="arch" type="xml">
            <search string="Search CV Uploads">
                <field name="filename"/>
                <field name="profile_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Needs Review" name="parsed" domain="[('state', '=', 'parsed')]"/>
                <filter string="Reviewed" name="reviewed" domain="[('state', '=', 'reviewed')]"/>
                <filter string="Imported" name="imported" domain="[('state', '=', 'imported')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Profile" name="group_profile" context="{'group_by': 'profile_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_job_pilot_cv_upload" model="ir.actions.act_window">
        <field name="name">CV Uploads</field>
        <field name="res_model">job_pilot.cv.upload</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_job_pilot_cv_upload_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Upload a CV (PDF or DOCX) to extract candidate data.</p>
        </field>
    </record>
</odoo>
