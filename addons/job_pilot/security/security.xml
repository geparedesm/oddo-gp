<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_job_pilot" model="ir.module.category">
        <field name="name">Job Pilot</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_job_pilot_user" model="res.groups">
        <field name="name">User: Manage own profile</field>
        <field name="category_id" ref="module_category_job_pilot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_job_pilot_manager" model="res.groups">
        <field name="name">Manager: Access all profiles</field>
        <field name="category_id" ref="module_category_job_pilot"/>
        <field name="implied_ids" eval="[(4, ref('job_pilot.group_job_pilot_user'))]"/>
    </record>

    <!-- Profile: users see only their own profile, managers see all -->
    <record id="job_pilot_profile_user_rule" model="ir.rule">
        <field name="name">Career Profile: own profile only</field>
        <field name="model_id" ref="model_job_pilot_profile"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('job_pilot.group_job_pilot_user'))]"/>
    </record>
    <record id="job_pilot_profile_manager_rule" model="ir.rule">
        <field name="name">Career Profile: all profiles</field>
        <field name="model_id" ref="model_job_pilot_profile"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('job_pilot.group_job_pilot_manager'))]"/>
    </record>

    <!-- Child records: scoped through profile_id.user_id -->
    <record id="job_pilot_attribute_user_rule" model="ir.rule">
        <field name="name">Career Profile Attribute: own profile only</field>
        <field name="model_id" ref="model_job_pilot_profile_attribute"/>
