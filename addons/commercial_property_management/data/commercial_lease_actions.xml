<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_commercial_lease" model="ir.actions.act_window">
        <field name="name">Lease Contracts</field>
        <field name="res_model">commercial.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('commercial_property_management.group_property_manager'))]"/>
    </record>

    <record id="action_commercial_lease_operations_dashboard" model="ir.actions.act_window">
        <field name="name">Lease Operations Dashboard</field>
        <field name="res_model">commercial.lease</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="groups_id" eval="[(4, ref('commercial_property_management.group_property_manager'))]"/>
    </record>
</odoo>
