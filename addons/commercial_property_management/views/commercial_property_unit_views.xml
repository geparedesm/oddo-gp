<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_unit_tree" model="ir.ui.view">
        <field name="name">commercial.property.unit.tree</field>
        <field name="model">commercial.property.unit</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'available'" decoration-info="state == 'rented'" decoration-warning="state == 'reserved'">
                <field name="code"/><field name="name"/><field name="bedrooms"/><field name="bathrooms"/><field name="parking_spaces"/><field name="property_id"/><field name="area"/><field name="currency_id" invisible="1"/><field name="state" widget="badge"/><field name="is_published"/>
            </tree>
        </field>
    </record>
    <record id="view_commercial_property_unit_form" model="ir.ui.view">
        <field name="name">commercial.property.unit.form</field>
        <field name="model">commercial.property.unit</field>
        <field name="arch" type="xml">
            <form string="Commercial Unit">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,rented,maintenance,inactive"/>
                    <field name="commercial_progress_stage" widget="statusbar" statusbar_visible="enquiry,inspection,reservation,application,lease" clickable="False" groups="commercial_property_management.group_property_manager"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box" groups="commercial_property_management.group_property_manager">
                        <button name="action_create_enquiry" type="object" class="oe_stat_button" icon="fa-comment-o" attrs="{'invisible': [('state', '!=', 'available')]}">
                            <div class="o_stat_info"><span class="o_stat_text">Create Enquiry</span></div>
                        </button>
                        <button name="action_schedule_inspection" type="object" class="oe_stat_button" icon="fa-calendar" attrs="{'invisible': [('state', '!=', 'available')]}">
                            <div class="o_stat_info"><span class="o_stat_text">Schedule Inspection</span></div>
                        </button>
                        <button name="action_create_reservation" type="object" class="oe_stat_button" icon="fa-bookmark-o" attrs="{'invisible': [('state', '!=', 'available')]}">
                            <div class="o_stat_info"><span class="o_stat_text">Create Reservation</span></div>
                        </button>
                        <button name="action_view_reservation" type="object" class="oe_stat_button" icon="fa-bookmark" attrs="{'invisible': [('state', '!=', 'reserved')]}">
                            <div class="o_stat_info"><span class="o_stat_text">View Reservation</span></div>
                        </button>
                        <button name="action_create_lease_application" type="object" class="oe_stat_button" icon="fa-file-text-o" attrs="{'invisible': [('state', '!=', 'reserved')]}">
                            <div class="o_stat_info"><span class="o_stat_text">Create Lease Application</span></div>
                        </button>
                        <button name="action_cancel_reservation" type="object" class="oe_stat_button" icon="fa-times" attrs="{'invisible': [('state', '!=', 'reserved')]}">
                            <div class="o_stat_info"><span class="o_stat_text">Cancel Reservation</span></div>
                        </button>
                        <button name="action_view_lease" type="object" class="oe_stat_button" icon="fa-file-text" attrs="{'invisible': [('state', '!=', 'rented')]}">
                            <div class="o_stat_info"><span class="o_stat_text">View Lease</span></div>
                        </button>
                        <button name="action_view_tenant" type="object" class="oe_stat_button" icon="fa-user" attrs="{'invisible': [('state', '!=', 'rented')]}">
                            <div class="o_stat_info"><span class="o_stat_text">View Tenant</span></div>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench" attrs="{'invisible': [('state', '!=', 'rented')]}">
                            <div class="o_stat_info"><span class="o_stat_text">View Maintenance</span></div>
                        </button>
                    </div>
                    <field name="image_ids" widget="one2many" mode="kanban" nolabel="1">
                        <kanban>
                            <field name="id"/>
                            <field name="sequence"/>
                            <field name="image_1920"/>
                            <field name="name"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click">
                                        <div class="o_kanban_image">
                                            <img t-att-src="kanban_image('commercial.property.unit.image', 'image_1920', record.id.raw_value)" alt="Unit image"/>
                                        </div>
                                        <div class="oe_kanban_details">
                                            <field name="name" placeholder="Image description"/>
                                            <field name="sequence" invisible="1"/>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form>
                            <sheet>
                                <field name="image_1920" widget="image"/>
                                <group>
                                    <field name="name" placeholder="Optional description"/>
                                    <field name="sequence"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Ground floor corner unit"/></h1><div><field name="code" readonly="1"/></div></div>
                    <group><group string="Unit Details"><field name="property_id" options="{'no_create': True}"/><field name="floor"/><field name="entrance_description"/><field name="area"/><field name="currency_id" invisible="1"/><field name="available_date"/></group><group string="Availability"><field name="state"/><field name="is_published"/><field name="active"/></group></group>
                    <group string="Automatic Rent Recommendation" groups="commercial_property_management.group_property_manager">
                        <group>
                            <field name="unit_adjustment_factor"/>
                            <field name="area_share" string="Informational Area Share (%)"/>
                            <field name="estimated_property_value" widget="monetary"/>
                            <field name="base_monthly_rent" widget="monetary"/>
                            <field name="recommended_monthly_rent" string="Recommended Monthly Rent" widget="monetary"/>
                            <field name="final_monthly_rent" string="Final Monthly Rent" widget="monetary"/>
                        </group>
                        <group>
                            <field name="minimum_suggested_rent" widget="monetary"/>
                            <field name="maximum_suggested_rent" widget="monetary"/>
                            <field name="rent_per_sqm" widget="monetary"/>
                            <field name="rent_difference" widget="monetary"/>
                            <field name="rent_difference_percent"/>
                            <field name="rent_status" widget="badge"/>
                        </group>
                    </group>
                    <group string="Unit Characteristics"><group><field name="bedrooms"/><field name="bathrooms"/><field name="half_bathrooms"/><field name="parking_spaces"/><field name="furnished"/><field name="pet_friendly"/></group><group><field name="floor_number"/><field name="total_floors"/><field name="balcony_area_sqm"/><field name="storage_rooms"/><field name="has_balcony"/><field name="has_laundry"/></group></group>
                    <notebook><page string="Public Listing" groups="commercial_property_management.group_property_manager"><group><field name="public_name"/><field name="public_monthly_rent" string="Public Monthly Rent" widget="monetary"/><field name="public_feature_ids" widget="many2many_tags"/></group><field name="public_description"/></page><page string="Lease History" groups="commercial_property_management.group_property_manager"><field name="lease_ids" context="{'default_property_id': property_id, 'default_unit_id': active_id}"><tree><field name="name"/><field name="tenant_id"/><field name="start_date"/><field name="end_date"/><field name="state"/></tree></field></page><page string="Internal Notes"><field name="notes"/></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_commercial_property_unit_search" model="ir.ui.view">
        <field name="name">commercial.property.unit.search</field>
        <field name="model">commercial.property.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="code"/><field name="property_id"/><field name="bedrooms"/><field name="bathrooms"/><field name="parking_spaces"/><filter name="available" string="Available" domain="[('state','=','available')]"/><filter name="published" string="Published" domain="[('is_published','=',True)]"/><filter name="furnished" string="Amoblado" domain="[('furnished','=',True)]"/><filter name="pet_friendly" string="Acepta Mascotas" domain="[('pet_friendly','=',True)]"/><filter name="has_parking" string="Con Estacionamiento" domain="[('parking_spaces','>',0)]"/><group expand="0" string="Group By"><filter name="group_bedrooms" string="Dormitorios" context="{'group_by':'bedrooms'}"/><filter name="group_bathrooms" string="Baños" context="{'group_by':'bathrooms'}"/><filter name="group_parking" string="Estacionamiento" context="{'group_by':'parking_spaces'}"/></group>
            </search>
        </field>
    </record>
    <record id="view_commercial_property_unit_kanban" model="ir.ui.view">
        <field name="name">commercial.property.unit.kanban</field>
        <field name="model">commercial.property.unit</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="state"/>
                <field name="bedrooms"/>
                <field name="bathrooms"/>
                <field name="parking_spaces"/>
                <field name="area"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <div class="text-muted">
                                    <t t-if="record.bedrooms.raw_value"><span t-esc="record.bedrooms.raw_value"/> hab.</t>
                                    <t t-if="record.bathrooms.raw_value"> - <span t-esc="record.bathrooms.raw_value"/> baños</t>
                                    <t t-if="record.parking_spaces.raw_value"> - <span t-esc="record.parking_spaces.raw_value"/> parking</t>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
