<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_visit_tree" model="ir.ui.view">
        <field name="name">commercial.property.visit.tree</field>
        <field name="model">commercial.property.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="lead_id"/><field name="unit_id"/><field name="scheduled_at"/><field name="assigned_user_id"/><field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_commercial_property_visit_form" model="ir.ui.view">
        <field name="name">commercial.property.visit.form</field>
        <field name="model">commercial.property.visit</field>
        <field name="arch" type="xml">
            <form string="Commercial Property Visit">
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" attrs="{'invisible':[('state','!=','requested')]}"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" attrs="{'invisible':[('state','!=','scheduled')]}"/>
                    <button name="action_complete" type="object" string="Complete" attrs="{'invisible':[('state','!=','confirmed')]}"/>
                    <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible':[('state','in',('completed','cancelled'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,scheduled,confirmed,completed,cancelled"/>
                </header>
                <sheet>
                    <group><group><field name="lead_id" options="{'no_create': True}"/><field name="unit_id" readonly="1"/><field name="property_id" readonly="1"/></group><group><field name="scheduled_at"/><field name="assigned_user_id"/></group></group>
                    <field name="notes"/>
                    <div class="oe_chatter"><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
