<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_maintenance_tree" model="ir.ui.view">
        <field name="name">commercial.property.maintenance.tree</field>
        <field name="model">commercial.property.maintenance</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'new'" decoration-warning="state in ('assigned', 'in_progress')" decoration-muted="state in ('completed', 'cancelled')">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="assigned_user_id"/>
                <field name="provider_id"/>
                <field name="due_date"/>
                <field name="cost_estimate" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_commercial_property_maintenance_form" model="ir.ui.view">
        <field name="name">commercial.property.maintenance.form</field>
        <field name="model">commercial.property.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Ticket">
                <header>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary" attrs="{'invisible': [('state', '!=', 'new')]}"/>
                    <button name="action_start" type="object" string="Start Work" class="btn-primary" attrs="{'invisible': [('state', '!=', 'assigned')]}"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" attrs="{'invisible': [('state', 'not in', ('assigned', 'in_progress'))]}"/>
                    <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible': [('state', 'in', ('completed', 'cancelled'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}" domain="[('property_id', '=', property_id)]"/>
                            <field name="category"/>
                        </group>
                        <group string="Assignment">
                            <field name="assigned_user_id"/>
                            <field name="provider_id"/>
                            <field name="due_date"/>
                            <field name="cost_estimate" widget="monetary"/>
                            <field name="actual_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="completion_notes" attrs="{'readonly': [('state', '=', 'completed')]}"/>
                        <field name="closed_by_id" readonly="1" attrs="{'invisible': [('state', '!=', 'completed')]}"/>
                        <field name="closed_at" readonly="1" attrs="{'invisible': [('state', '!=', 'completed')]}"/>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commercial_property_maintenance_kanban" model="ir.ui.view">
        <field name="name">commercial.property.maintenance.kanban</field>
        <field name="model">commercial.property.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="category"/>
                <field name="due_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <strong><field name="name"/></strong>
                            <div><field name="property_id"/><t t-if="record.unit_id.value"> - <field name="unit_id"/></t></div>
                            <div class="text-muted"><field name="category"/></div>
                            <div t-if="record.due_date.value"><field name="due_date"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_commercial_property_maintenance_search" model="ir.ui.view">
        <field name="name">commercial.property.maintenance.search</field>
        <field name="model">commercial.property.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance Tickets">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="assigned_user_id"/>
                <field name="provider_id"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('completed', 'cancelled'))]"/>
                <filter name="unassigned" string="Unassigned" domain="[('assigned_user_id', '=', False), ('provider_id', '=', False)]"/>
                <filter name="my_tickets" string="Assigned to Me" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="overdue" string="Overdue" domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('completed', 'cancelled'))]"/>
                <separator/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_by_property" string="Building" context="{'group_by': 'property_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_commercial_property_maintenance_pivot" model="ir.ui.view">
        <field name="name">commercial.property.maintenance.pivot</field>
        <field name="model">commercial.property.maintenance</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Dashboard">
                <field name="category" type="row"/>
                <field name="state" type="col"/>
                <field name="cost_estimate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_commercial_property_form_maintenance" model="ir.ui.view">
        <field name="name">commercial.property.form.maintenance</field>
        <field name="model">commercial.property</field>
        <field name="inherit_id" ref="commercial_property_management.view_commercial_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='available_date']" position="after">
                <field name="operational_status" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Maintenance" groups="commercial_property_management.group_property_manager">
                    <field name="maintenance_ids" context="{'default_property_id': active_id}" mode="tree,form">
                        <tree>
                            <field name="name"/>
                            <field name="unit_id"/>
                            <field name="category"/>
                            <field name="due_date"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_commercial_property_unit_form_maintenance" model="ir.ui.view">
        <field name="name">commercial.property.unit.form.maintenance</field>
        <field name="model">commercial.property.unit</field>
        <field name="inherit_id" ref="commercial_property_management.view_commercial_property_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_published']" position="before">
                <field name="operational_status" readonly="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Maintenance" groups="commercial_property_management.group_property_manager">
                    <field name="maintenance_ids" context="{'default_unit_id': active_id, 'default_property_id': property_id}" mode="tree,form">
                        <tree>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="due_date"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
