<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_distribution_channel_tree" model="ir.ui.view">
        <field name="name">commercial.property.distribution.channel.tree</field>
        <field name="model">commercial.property.distribution.channel</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="channel_type"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_commercial_property_distribution_channel_form" model="ir.ui.view">
        <field name="name">commercial.property.distribution.channel.form</field>
        <field name="model">commercial.property.distribution.channel</field>
        <field name="arch" type="xml">
            <form string="Distribution Channel">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Downtown Property Portal"/></h1>
                    </div>
                    <group>
                        <field name="channel_type"/>
                        <field name="active"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commercial_property_unit_form_listing_quality" model="ir.ui.view">
        <field name="name">commercial.property.unit.form.listing.quality</field>
        <field name="model">commercial.property.unit</field>
        <field name="inherit_id" ref="commercial_property_management.view_commercial_property_unit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='public_feature_ids']" position="after">
                <field name="public_location_hint" placeholder="e.g. Near the central plaza, 5 minutes from the main avenue"/>
                <field name="virtual_tour_url" placeholder="e.g. https://tours.example.com/unit-123"/>
                <field name="publication_quality_ok" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='public_description']" position="after">
                <group string="Publication Status">
                    <group>
                        <field name="publication_date" readonly="1"/>
                        <field name="publication_approved_by_id" readonly="1"/>
                        <field name="publication_expiry_date"/>
                    </group>
                    <group>
                        <field name="unpublish_reason"/>
                        <field name="unpublish_notes"/>
                    </group>
                </group>
                <group string="Distribution">
                    <field name="distribution_channel_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_commercial_property_lead_form_channel" model="ir.ui.view">
        <field name="name">commercial.property.lead.form.channel</field>
        <field name="model">commercial.property.lead</field>
        <field name="inherit_id" ref="commercial_property_management.view_commercial_property_lead_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source']" position="after">
                <field name="source_channel_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_commercial_property_lead_search_channel" model="ir.ui.view">
        <field name="name">commercial.property.lead.search.channel</field>
        <field name="model">commercial.property.lead</field>
        <field name="inherit_id" ref="commercial_property_management.view_commercial_property_lead_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='unit_id']" position="after">
                <field name="source_channel_id"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <group expand="0" string="Group By">
                    <filter name="group_by_channel" string="Campaign / Channel" context="{'group_by': 'source_channel_id'}"/>
                    <filter name="group_by_lead_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_commercial_property_lead_pivot_campaign" model="ir.ui.view">
        <field name="name">commercial.property.lead.pivot.campaign</field>
        <field name="model">commercial.property.lead</field>
        <field name="arch" type="xml">
            <pivot string="Campaign Attribution">
                <field name="source_channel_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
