<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_reservation_tree" model="ir.ui.view">
        <field name="name">commercial.property.reservation.tree</field>
        <field name="model">commercial.property.reservation</field>
        <field name="arch" type="xml">
            <tree decoration-warning="state == 'requested'" decoration-success="state == 'approved'">
                <field name="lead_id"/><field name="unit_id"/><field name="start_date"/><field name="end_date"/><field name="expires_at"/><field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_commercial_property_reservation_form" model="ir.ui.view">
        <field name="name">commercial.property.reservation.form</field>
        <field name="model">commercial.property.reservation</field>
        <field name="arch" type="xml">
            <form string="Commercial Property Reservation">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" attrs="{'invisible':[('state','!=','requested')]}"/>
                    <button name="action_cancel" type="object" string="Cancel" attrs="{'invisible':[('state','not in',('requested','approved'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved,expired,cancelled"/>
                </header>
                <sheet>
                    <group><group><field name="lead_id" options="{'no_create': True}"/><field name="unit_id" readonly="1"/><field name="property_id" readonly="1"/></group><group><field name="start_date"/><field name="end_date"/><field name="expires_at"/><field name="approved_by_id" readonly="1"/></group></group>
                    <field name="notes"/>
                    <div class="oe_chatter"><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
