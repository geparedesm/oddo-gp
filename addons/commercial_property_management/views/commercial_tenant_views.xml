<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_commercial_tenant" model="ir.ui.view">
        <field name="name">res.partner.form.commercial.tenant</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="arch" type="xml">
            <form string="Commercial Tenant">
                <sheet>
                    <group>
                        <group string="Tenant Details">
                            <field name="company_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="name" required="1" placeholder="e.g. Brandom Freeman or Lumber Inc"/>
                            <field name="tenant_identification_number"/>
                        </group>
                        <group string="Contact Details">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                    </group>
                    <group string="Private Notes">
                        <field name="tenant_internal_notes" nolabel="1" placeholder="Add private notes for the property management team..."/>
                    </group>
                    <field name="is_commercial_tenant" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commercial_tenant_form_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="commercial_property_management.action_commercial_tenant"/>
        <field name="view_id" ref="commercial_property_management.view_partner_form_commercial_tenant"/>
        <field name="view_mode">form</field>
        <field name="sequence" eval="10"/>
    </record>

    <record id="action_commercial_tenant_tree_view" model="ir.actions.act_window.view">
        <field name="act_window_id" ref="commercial_property_management.action_commercial_tenant"/>
        <field name="view_mode">tree</field>
        <field name="sequence" eval="1"/>
    </record>

    <record id="view_partner_search_commercial_tenant" model="ir.ui.view">
        <field name="name">res.partner.search.commercial.tenant</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="commercial_tenant" string="Commercial Tenants" domain="[('is_commercial_tenant', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
