<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem
        id="menu_commercial_property_root"
        name="Commercial Properties"
        sequence="45"
        groups="commercial_property_management.group_property_user"
        action="commercial_property_management.action_commercial_property"
        web_icon="commercial_property_management,static/description/icon.png"
    />

    <!-- Functional-area containers (Phase 19): group the previously flat menu
         list by business flow so the top app bar does not overflow. -->
    <menuitem id="menu_commercial_property_area" name="Properties" parent="menu_commercial_property_root" sequence="10" groups="commercial_property_management.group_property_user"/>
    <menuitem id="menu_commercial_leasing" name="Leasing" parent="menu_commercial_property_root" sequence="20" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_operations" name="Operations" parent="menu_commercial_property_root" sequence="30" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_analytics" name="Analytics" parent="menu_commercial_property_root" sequence="40" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_configuration" name="Configuration" parent="menu_commercial_property_root" sequence="50" groups="commercial_property_management.group_property_administrator"/>

    <!-- Properties -->
    <menuitem
        id="menu_commercial_property"
        name="Properties"
        parent="menu_commercial_property_area"
        action="commercial_property_management.action_commercial_property"
        sequence="10"
        groups="commercial_property_management.group_property_user"
    />

    <menuitem
        id="menu_commercial_property_unit"
        name="Units"
        parent="menu_commercial_property_area"
        action="commercial_property_management.action_commercial_property_unit"
        sequence="20"
        groups="commercial_property_management.group_property_user"
    />

    <!-- Leasing: ordered to follow the business flow Enquiry -> Inspection ->
         Reservation -> Lease Application -> Tenant -> Lease. -->
    <menuitem id="menu_commercial_property_lead" name="Enquiries" parent="menu_commercial_leasing" action="commercial_property_management.action_commercial_property_lead" sequence="10" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_visit" name="Inspections" parent="menu_commercial_leasing" action="commercial_property_management.action_commercial_property_visit" sequence="20" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_reservation" name="Reservations" parent="menu_commercial_leasing" action="commercial_property_management.action_commercial_property_reservation" sequence="30" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_application" name="Lease Applications" parent="menu_commercial_leasing" action="commercial_property_management.action_commercial_property_application" sequence="40" groups="commercial_property_management.group_property_manager"/>

    <menuitem
        id="menu_commercial_tenant"
        name="Tenants"
        parent="menu_commercial_leasing"
        action="commercial_property_management.action_commercial_tenant"
        sequence="50"
        groups="commercial_property_management.group_property_manager"
    />

    <menuitem
        id="menu_commercial_lease"
        name="Leases"
        parent="menu_commercial_leasing"
        action="commercial_property_management.action_commercial_lease"
        sequence="60"
        groups="commercial_property_management.group_property_manager"
    />

    <!-- Operations -->
    <menuitem id="menu_commercial_property_maintenance" name="Maintenance" parent="menu_commercial_operations" action="commercial_property_management.action_commercial_property_maintenance" sequence="10" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_maintenance_dashboard" name="Maintenance Dashboard" parent="menu_commercial_operations" action="commercial_property_management.action_commercial_property_maintenance_dashboard" sequence="20" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_handover" name="Delivery / Return Checklists" parent="menu_commercial_operations" action="commercial_property_management.action_commercial_property_handover" sequence="30" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_lease_penalty" name="Penalties" parent="menu_commercial_operations" action="commercial_property_management.action_commercial_lease_penalty" sequence="40" groups="commercial_property_management.group_property_manager"/>

    <!-- Analytics: dashboards and reporting only. Distribution Channels is
         plain configuration data (see menu_commercial_configuration below),
         not a report, so it is not duplicated here. -->
    <menuitem
        id="menu_commercial_lease_operations_dashboard"
        name="Operations Dashboard"
        parent="menu_commercial_analytics"
        action="commercial_property_management.action_commercial_lease_operations_dashboard"
        sequence="10"
        groups="commercial_property_management.group_property_manager"
    />
    <menuitem id="menu_commercial_property_portfolio" name="Portfolio Performance" parent="menu_commercial_analytics" action="commercial_property_management.action_commercial_property_portfolio" sequence="20" groups="commercial_property_management.group_property_manager"/>
    <menuitem id="menu_commercial_property_campaign_attribution" name="Campaign Attribution" parent="menu_commercial_analytics" action="commercial_property_management.action_commercial_property_campaign_attribution" sequence="30" groups="commercial_property_management.group_property_manager"/>

    <!-- Configuration: administrator-only, kept out of regular managers'
         daily navigation (Phase 19 tightens this from group_property_manager). -->
    <menuitem id="menu_commercial_property_integration_alert" name="Integration Alerts" parent="menu_commercial_configuration" action="commercial_property_management.action_commercial_property_integration_alert" sequence="10" groups="commercial_property_management.group_property_administrator"/>
    <menuitem id="menu_commercial_property_distribution_channel" name="Distribution Channels" parent="menu_commercial_configuration" action="commercial_property_management.action_commercial_property_distribution_channel" sequence="20" groups="commercial_property_management.group_property_administrator"/>
    <menuitem id="menu_commercial_property_settings" name="WhatsApp Policy" parent="menu_commercial_configuration" action="commercial_property_management.action_commercial_property_settings" sequence="30" groups="base.group_system"/>
</odoo>
