<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commercial_property_integration_alert_tree" model="ir.ui.view">
        <field name="name">commercial.property.integration.alert.tree</field>
        <field name="model">commercial.property.integration.alert</field>
        <field name="arch" type="xml">
            <tree><field name="name"/><field name="channel"/><field name="severity" widget="badge"/><field name="state" widget="badge"/><field name="create_date"/></tree>
        </field>
    </record>
    <record id="view_commercial_property_integration_alert_form" model="ir.ui.view">
        <field name="name">commercial.property.integration.alert.form</field>
        <field name="model">commercial.property.integration.alert</field>
        <field name="arch" type="xml">
            <form string="Integration Alert"><header><button name="action_resolve" type="object" string="Resolve" class="btn-primary" attrs="{'invisible':[('state','=','resolved')]}"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="channel"/><field name="severity"/><field name="details"/><field name="fingerprint" readonly="1"/></group><div class="oe_chatter"><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></sheet></form>
        </field>
    </record>
</odoo>
