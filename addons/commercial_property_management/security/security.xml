<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_commercial_property_management" model="ir.module.category">
        <field name="name">Commercial Property Management</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_property_user" model="res.groups">
        <field name="name">Property User</field>
        <field name="category_id" ref="module_category_commercial_property_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="category_id" ref="module_category_commercial_property_management"/>
        <field name="implied_ids" eval="[(4, ref('commercial_property_management.group_property_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_property_administrator" model="res.groups">
        <field name="name">Property Administrator</field>
        <field name="category_id" ref="module_category_commercial_property_management"/>
        <field name="implied_ids" eval="[(4, ref('commercial_property_management.group_property_manager'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('commercial_property_management.group_property_administrator'))]"/>
    </record>

    <record id="commercial_property_company_rule" model="ir.rule">
        <field name="name">Commercial Property multi-company access</field>
        <field name="model_id" ref="model_commercial_property"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('commercial_property_management.group_property_user'))]"/>
    </record>

    <record id="commercial_lease_company_rule" model="ir.rule">
        <field name="name">Commercial Lease multi-company access</field>
        <field name="model_id" ref="model_commercial_lease"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('commercial_property_management.group_property_manager'))]"/>
    </record>
</odoo>
